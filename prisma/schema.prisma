// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth ---

enum UserRole {
  ADMIN
  CLIENT
  STAFF

  @@map("user_role")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          UserRole  @default(CLIENT)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

// --- Plan System ---

enum BillingInterval {
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

enum PlanType {
  EDUCATION
  GOVERNMENT

  @@map("plan_type")
}

model Plan {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  planType        PlanType
  billingInterval BillingInterval @default(MONTHLY)
  discount        Float           @default(0)
  monthlyPrice    Float
  yearlyPrice     Float?
  installationFee Float           @default(0)

  features   String[]
  inclusions String[]
  addons     String[]
  equipment  String[]

  hasKiosk Boolean @default(false) @map("has_kiosk")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plan")
}

// --- Subscription ---

enum SubscriptionStatus {
  FOR_PAYMENT
  FOR_INSTALLATION

  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("subscription_status")
}

model Subscription {
  id              String          @id @default(uuid())
  planType        PlanType
  billingInterval BillingInterval @default(MONTHLY)
  price           Float
  discount        Float           @default(0)

  installationDate   DateTime?          @map("installation_date")
  subscriptionStatus SubscriptionStatus @default(FOR_PAYMENT) @map("subscription_status")

  billingStartDate DateTime? @map("billing_start_date") // When billing starts (= installationDate)
  nextBillingDate  DateTime? @map("next_billing_date") // Next payment due date
  gracePeriodDays  Int       @default(7) @map("grace_period_days") // Days before overdue

  paymentHistory PaymentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriberId String
  subscriber   User   @relation(fields: [subscriberId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriberDetailId String
  subscriberDetail   SubscriberDetail @relation(fields: [subscriberDetailId], references: [id], onDelete: Cascade)

  billingDetailId String
  billingDetail   BillingDetail @relation(fields: [billingDetailId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model SubscriberDetail {
  id          String  @id @default(uuid())
  clientName  String? @map("client_name")
  siteAddress String? @map("site_address")

  contactPerson      String  @map("contact_person")
  contactEmail       String  @map("contact_email")
  contactNumber      String  @map("contact_number")
  contactDesignation String? @map("contact_designation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscriber")
}

model BillingDetail {
  id String @id @default(uuid())

  billingName  String @map("billing_name")
  billingEmail String @map("billing_email")
  billingPhone String @map("billing_phone")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("billing_detail")
}

// --- Payments ---

enum PaymentType {
  CASH
  CARD
  GCASH
  PAYMAYA
  QRPH

  @@map("payment_method_type")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED

  @@map("payment_status")
}

model PaymentHistory {
  id          String        @id @default(uuid())
  type        PaymentType
  amount      Float
  paymentDate DateTime      @default(now()) @map("payment_date")
  description String?
  status      PaymentStatus

  billingName  String @map("billing_name")
  billingEmail String @map("billing_email")
  billingPhone String @map("billing_phone")

  paymentIntentId String
  clientKey       String

  subscriptionId   String
  subscriptionInfo Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_history")
}
